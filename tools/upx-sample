#!/usr/bin/env python3
"""Generate UPX sample fixtures without a Windows toolchain.

Lanes, chosen by what the local host actually supports (verified empirically
with upx 5.2.1 from Homebrew on macOS arm64):

- ELF: a minimal static ELF64 x86-64 is hand-crafted here (no cross compiler
  needed). `upx -o packed plain` and `upx -d` work for ELF on any host, so the
  full pack -> detect -> unpack positive path runs on macOS/Linux/Windows.
  The unpacked image is byte-identical to the crafted original (roundtrip).
- Mach-O (macOS only): `cc` compiles a trivial program; `upx --force-macos`
  packs it (macho/arm64). Upstream limitation, recorded honestly: brew upx
  5.2.1 can pack Mach-O but `upx -d` rejects its own output with
  NotPackedException (while `--file-info` reports AlreadyPackedException), so
  the Mach-O lane only exercises section-name DETECTION, not unpacking.

Every produced file is chmod +x because UPX refuses to pack plain files.

Usage:
  python3 tools/upx-sample --out DIR [--upx PATH] [--cc CC] [--kinds elf,macho]
Prints a JSON manifest of the produced files.
"""
import argparse
import json
import os
import shutil
import struct
import subprocess
import sys
import tempfile
from pathlib import Path

# xor edi,edi; mov eax,60 (exit); syscall — a static ELF needs no libc.
_CODE = b"\x31\xff\xb8\x3c\x00\x00\x00\x0f\x05"
_PAD_BYTES = 96 * 1024  # UPX skips files it considers "too small"
_C_SOURCE = '#include <stdio.h>\nint main(void){ puts("re-upx-sample"); return 0; }\n'


def build_plain_elf(path: Path) -> Path:
    """Hand-craft a minimal static ELF64 x86-64 ET_EXEC with two program headers."""
    total = 64 + 2 * 56 + len(_CODE) + _PAD_BYTES
    ehdr = b"\x7fELF" + bytes([2, 1, 1, 0]) + b"\x00" * 8
    ehdr += struct.pack("<HHI", 2, 0x3E, 1)  # ET_EXEC, EM_X86_64, EV_CURRENT
    ehdr += struct.pack("<QQQ", 0x400078, 64, 0)  # entry, phoff, shoff=0
    ehdr += struct.pack("<IHHHHHH", 0, 64, 56, 2, 0, 0, 0)  # phentsize=56 phnum=2
    load = struct.pack("<IIQQQQQQ", 1, 5, 0, 0x400000, 0x400000, total, total, 0x1000)
    stack = struct.pack("<IIQQQQQQ", 0x6474e551, 6, 0, 0, 0, 0, 0, 0x10)  # PT_GNU_STACK
    blob = ehdr + load + stack + _CODE + b"\x00" * (total - 64 - 112 - len(_CODE))
    path.write_bytes(blob)
    os.chmod(path, 0o755)  # upx: "file not executable; try 'chmod +x'"
    return path


def pack(upx: Path, src: Path, dst: Path, extra: tuple[str, ...] = ()) -> str:
    """Pack `src` into `dst` with the real upx binary; returns combined output."""
    run = subprocess.run(
        [str(upx), *extra, "-o", str(dst), str(src)],
        capture_output=True, text=True, timeout=60,
    )
    if run.returncode != 0 or not Path(dst).is_file():
        detail = (run.stderr or run.stdout or "").strip().splitlines()
        raise RuntimeError(f"upx pack failed (exit {run.returncode}): {detail[-1] if detail else 'no output'}")
    return "\n".join(filter(None, (run.stdout.strip(), run.stderr.strip())))


def corrupt_truncated(src: Path, dst: Path) -> Path:
    """Damage a packed sample by truncation: `upx -d` must fail on it.

    Byte flips inside the zero padding are tolerated by UPX (verified), so
    truncation of the packed stream is the deterministic negative control.
    """
    data = Path(src).read_bytes()
    Path(dst).write_bytes(data[: len(data) * 2 // 3])
    os.chmod(dst, 0o755)
    return dst


def build_macho(cc: str, workdir: Path, dst: Path) -> Path:
    """Compile a trivial Mach-O with the local cc toolchain."""
    source = workdir / "sample.c"
    source.write_text(_C_SOURCE)
    run = subprocess.run([cc, "-O2", "-o", str(dst), str(source)], capture_output=True, text=True, timeout=60)
    if run.returncode != 0 or not dst.is_file():
        raise RuntimeError(f"cc failed: {run.stderr.strip()[:500]}")
    return dst


def upx_version(upx: Path) -> str:
    run = subprocess.run([str(upx), "--version"], capture_output=True, text=True, timeout=10)
    text = (run.stdout or run.stderr).strip()
    return text.splitlines()[0].strip() if text else "unknown"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", required=True, type=Path, help="output directory for generated samples")
    parser.add_argument("--upx", type=Path, default=Path(shutil.which("upx") or ""), help="upx executable (default: PATH)")
    parser.add_argument("--cc", default=shutil.which("cc") or "", help="C compiler for the Mach-O lane")
    parser.add_argument("--kinds", default="elf,macho", help="comma list from: elf,macho")
    args = parser.parse_args()
    if not args.upx or not args.upx.is_file():
        print("error: a real upx executable is required (--upx or PATH)", file=sys.stderr)
        return 2
    args.out.mkdir(parents=True, exist_ok=True)
    manifest: dict[str, object] = {"upx": str(args.upx), "upx_version": upx_version(args.upx)}
    kinds = {item.strip() for item in args.kinds.split(",") if item.strip()}

    if "elf" in kinds:
        plain = build_plain_elf(args.out / "plain.elf")
        pack(args.upx, plain, args.out / "packed.elf")
        corrupt_truncated(args.out / "packed.elf", args.out / "corrupted.elf")
        manifest.update({
            "plain_elf": str(plain),
            "packed_elf": str(args.out / "packed.elf"),
            "corrupted_elf": str(args.out / "corrupted.elf"),
            "corruption": "truncated to 2/3 length; upx -d must fail (negative control)",
        })

    if "macho" in kinds:
        if not args.cc:
            print("warning: no cc on PATH; Mach-O lane skipped", file=sys.stderr)
        else:
            with tempfile.TemporaryDirectory(prefix="upx-sample-macho-") as tmp:
                plain = build_macho(args.cc, Path(tmp), args.out / "plain.macho")
                pack(args.upx, plain, args.out / "packed.macho", extra=("--force-macos",))
            manifest.update({
                "plain_macho": str(args.out / "plain.macho"),
                "packed_macho": str(args.out / "packed.macho"),
                "macho_note": "upx --force-macos packs macho/arm64; upx -d rejects its own Mach-O output (NotPackedException) — detection lane only",
            })

    print(json.dumps(manifest, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
